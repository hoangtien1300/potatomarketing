{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/calendar",
      "destination": "/api/calendar"
    },
    {
      "source": "/api/calendar/sync",
      "destination": "/api/calendar-sync"
    },
    {
      "source": "/api/tasks",
      "destination": "/api/tasks"
    },
    {
      "source": "/api/tasks/(.*)",
      "destination": "/api/tasks"
    },
    {
      "source": "/api/work-logs",
      "destination": "/api/work-logs"
    },
    {
      "source": "/api/work-logs/(.*)",
      "destination": "/api/work-logs"
    },
    {
      "source": "/api/survey/submit",
      "destination": "/api/survey"
    },
    {
      "source": "/api/about-us/sync",
      "destination": "/api/about-us-sync"
    },
    {
      "source": "/api/about-us/batch-update",
      "destination": "/api/about-us-batch"
    },
    {
      "source": "/api/about-us",
      "destination": "/api/about-us"
    },
    {
      "source": "/score",
      "destination": "/score.html"
    },
    {
      "source": "/score/(.*)",
      "destination": "/score.html"
    },
    {
      "source": "/bang-diem",
      "destination": "/score.html"
    },
    {
      "source": "/bang-diem/(.*)",
      "destination": "/score.html"
    },
    {
      "source": "/survey",
      "destination": "/survey.html"
    },
    {
      "source": "/khao-sat",
      "destination": "/survey.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/facebook/(.*)",
      "destination": "/api/facebook"
    },
    {
      "source": "/api/facebook",
      "destination": "/api/facebook"
    },
    {
      "source": "/api/calendar",
      "destination": "/api/calendar"
    },
    {
      "source": "/api/calendar/sync",
      "destination": "/api/calendar-sync"
    },
    {
      "source": "/api/tasks",
      "destination": "/api/tasks"
    },
    {
      "source": "/api/tasks/(.*)",
      "destination": "/api/tasks"
    },
    {
      "source": "/api/work-logs",
      "destination": "/api/work-logs"
    },
    {
      "source": "/api/work-logs/(.*)",
      "destination": "/api/work-logs"
    },
    {
      "source": "/api/survey/submit",
      "destination": "/api/survey"
    },
    {
      "source": "/api/about-us/sync",
      "destination": "/api/about-us-sync"
    },
    {
      "source": "/api/about-us/batch-update",
      "destination": "/api/about-us-batch"
    },
    {
      "source": "/api/about-us",
      "destination": "/api/about-us"
    },
    {
      "source": "/score",
      "destination": "/score"
    },
    {
      "source": "/score/(.*)",
      "destination": "/score"
    },
    {
      "source": "/bang-diem",
      "destination": "/score"
    },
    {
      "source": "/bang-diem/(.*)",
      "destination": "/score"
    },
    {
      "source": "/survey",
      "destination": "/survey"
    },
    {
      "source": "/khao-sat",
      "destination": "/survey"
    },
    {
      "source": "/bao-cao",
      "destination": "/index"
    },
    {
      "source": "/bao-cao/(.*)",
      "destination": "/index"
    },
    {
      "source": "/cai-dat",
      "destination": "/index"
    },
    {
      "source": "/cai-dat/(.*)",
      "destination": "/index"
    },
    {
      "source": "/cong-cu",
      "destination": "/index"
    },
    {
      "source": "/cong-cu/(.*)",
      "destination": "/index"
    },
    {
      "source": "/tool",
      "destination": "/index"
    },
    {
      "source": "/tool/(.*)",
      "destination": "/index"
    },
    {
      "source": "/lich-dang-bai",
      "destination": "/index"
    },
    {
      "source": "/lich-dang-bai/(.*)",
      "destination": "/index"
    },
    {
      "source": "/nhiem-vu",
      "destination": "/index"
    },
    {
      "source": "/nhiem-vu/(.*)",
      "destination": "/index"
    },
    {
      "source": "/tasks",
      "destination": "/index"
    },
    {
      "source": "/tasks/(.*)",
      "destination": "/index"
    },
    {
      "source": "/dashboard",
      "destination": "/index"
    },
    {
      "source": "/dashboard/(.*)",
      "destination": "/index"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}